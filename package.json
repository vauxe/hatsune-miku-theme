{
  "name": "hatsune-miku-ohime-sama-theme",
  "displayName": "Hatsune Miku Ohime-sama Theme",
  "publisher": "vauxe",
  "description": "A VS Code color theme traced from Hatsune Miku's character design. Dark and light variants, built with perceptual color science.",
  "version": "3.9.39",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vauxe/hatsune-miku-theme.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "miku",
    "hatsune-miku",
    "vocaloid",
    "color-theme"
  ],
  "galleryBanner": {
    "color": "#1A1F24",
    "theme": "dark"
  },
  "scripts": {
    "build": "tsc && tsx src/generator.ts && tsx src/tools/docgen.ts",
    "build:vscode": "tsc && tsx src/generator.ts vscode && tsx src/tools/docgen.ts",
    "build:ports": "tsc && tsx src/generator.ts ports && tsx src/tools/docgen.ts",
    "readability:dark": "tsx src/tools/readability.ts --theme themes/hatsune-miku-theme-color-theme.json",
    "readability:light": "tsx src/tools/readability.ts --theme themes/hatsune-miku-snow-color-theme.json",
    "readability:ports": "tsx src/tools/readability-ports.ts",
    "readability:web": "node --import tsx src/ports/web.test.ts",
    "vscode:prepublish": "npm run build",
    "docs:gen": "tsx src/tools/docgen.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "colorjs.io": "^0.6.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "themes": [
      {
        "label": "Hatsune Miku Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/hatsune-miku-theme-color-theme.json"
      },
      {
        "label": "Hatsune Miku Theme (Snow Miku)",
        "uiTheme": "vs",
        "path": "./themes/hatsune-miku-snow-color-theme.json"
      }
    ]
  }
}
