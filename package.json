{
  "name": "hatsune-miku-theme",
  "displayName": "Hatsune Miku Theme",
  "publisher": "vauxe",
  "description": "A dark theme where every color is traced from Hatsune Miku's character design, built with perceptual color science.",
  "version": "3.9.39",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vauxe/hatsune-miku-theme.git"
  },
  "keywords": [
    "theme",
    "color-theme",
    "hatsune-miku",
    "vocaloid",
    "dark-theme",
    "teal"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "tsc && node dist/generator.js",
    "build:theme": "node dist/generator.js",
    "watch": "tsc -w",
    "compile": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "prepublishOnly": "npm run build",
    "readability": "tsx src/tools/readability.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "themes": [
      {
        "label": "Hatsune Miku Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/hatsune-miku-theme-color-theme.json"
      }
    ]
  },
  "dependencies": {
    "colorjs.io": "^0.6.1",
    "culori": "^4.0.2"
  }
}
