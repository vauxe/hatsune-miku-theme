{
  "name": "hatsune-miku-theme",
  "displayName": "Hatsune Miku Theme",
  "publisher": "vauxe",
  "description": "A VS Code color theme traced from Hatsune Miku's character design. Dark and light variants, built with perceptual color science.",
  "version": "3.9.39",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vauxe/hatsune-miku-theme.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "miku",
    "hatsune-miku",
    "vocaloid",
    "color-theme"
  ],
  "galleryBanner": {
    "color": "#1A1F24",
    "theme": "dark"
  },
  "scripts": {
    "build": "tsc && node dist/generator.js",
    "build:vscode": "tsc && node dist/generator.js vscode",
    "build:targets": "tsc && node dist/generator.js targets",
    "watch": "tsc -w",
    "compile": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "prepublishOnly": "npm run build",
    "readability:dark": "tsx src/tools/readability.ts --theme themes/hatsune-miku-theme-color-theme.json",
    "readability:light": "tsx src/tools/readability.ts --theme themes/hatsune-miku-snow-color-theme.json",
    "readability:targets": "tsx src/tools/readability-targets.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "colorjs.io": "^0.6.1",
    "culori": "^4.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "themes": [
      {
        "label": "Hatsune Miku Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/hatsune-miku-theme-color-theme.json"
      },
      {
        "label": "Hatsune Miku Theme (Snow Miku)",
        "uiTheme": "vs",
        "path": "./themes/hatsune-miku-snow-color-theme.json"
      }
    ]
  },
  "dependencies": {}
}
