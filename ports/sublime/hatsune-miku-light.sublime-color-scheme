{
  "name": "Hatsune Miku (Snow Miku)",
  "author": "vauxe",
  "variables": {},
  "globals": {
    "background": "#F5F0E2",
    "foreground": "#753826",
    "invisibles": "#919496",
    "caret": "#E88493",
    "block_caret": "#E8849340",
    "line_highlight": "#D5EAF4",
    "selection": "#5688A040",
    "selection_foreground": "#753826",
    "selection_border": "#4E9CA140",
    "selection_border_width": "1",
    "inactive_selection": "#5688A025",
    "inactive_selection_foreground": "#646A6D",
    "selection_corner_style": "round",
    "find_highlight": "#89670060",
    "find_highlight_foreground": "#F5F0E2",
    "scroll_highlight": "#4E9CA160",
    "scroll_selected_highlight": "#E8849380",
    "highlight": "#4E9CA140",
    "gutter": "#F5F0E2",
    "gutter_foreground": "#8B8E90",
    "gutter_foreground_highlight": "#4E9CA1",
    "line_diff_added": "#007954",
    "line_diff_modified": "#9B4900",
    "line_diff_deleted": "#7900A4",
    "minimap_border": "#6F848E",
    "brackets_foreground": "#E88493",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#E88493",
    "bracket_contents_options": "underline",
    "tags_foreground": "#E88493",
    "tags_options": "stippled_underline",
    "guide": "#8B8E90",
    "active_guide": "#4E9CA1",
    "stack_guide": "#646A6D",
    "misspelling": "#BF0028",
    "fold_marker": "#8B8E90",
    "accent": "#4E9CA1",
    "shadow": "#00000040",
    "shadow_width": "4",
    "popup_css": "",
    "phantom_css": "",
    "sheet_css": ""
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#578F92",
      "font_style": "italic"
    },
    {
      "name": "Documentation Comment",
      "scope": "comment.block.documentation, comment.line.documentation",
      "foreground": "#498083",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "foreground": "#007284"
    },
    {
      "name": "Control Keyword",
      "scope": "keyword.control",
      "foreground": "#007284"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, punctuation.accessor",
      "foreground": "#B80067"
    },
    {
      "name": "Storage",
      "scope": "storage.type",
      "foreground": "#007284"
    },
    {
      "name": "Storage Modifier",
      "scope": "storage.modifier",
      "foreground": "#007284"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call",
      "foreground": "#896700"
    },
    {
      "name": "Built-in Function",
      "scope": "support.function",
      "foreground": "#764A00"
    },
    {
      "name": "Method",
      "scope": "entity.name.function.member, meta.method-call",
      "foreground": "#896700"
    },
    {
      "name": "Class",
      "scope": "entity.name.class, entity.other.inherited-class",
      "foreground": "#346900"
    },
    {
      "name": "Type",
      "scope": "entity.name.type, support.type",
      "foreground": "#8B12BA"
    },
    {
      "name": "Interface",
      "scope": "entity.name.interface",
      "foreground": "#007D57"
    },
    {
      "name": "Struct",
      "scope": "entity.name.struct",
      "foreground": "#346900"
    },
    {
      "name": "Enum",
      "scope": "entity.name.enum",
      "foreground": "#346900"
    },
    {
      "name": "Enum Member",
      "scope": "variable.other.enummember, constant.other.enum",
      "foreground": "#0058A3"
    },
    {
      "name": "Type Parameter",
      "scope": "entity.name.type.parameter",
      "foreground": "#7B5393"
    },
    {
      "name": "Namespace",
      "scope": "entity.name.namespace, entity.name.module",
      "foreground": "#8B12BA"
    },
    {
      "name": "Support Class",
      "scope": "support.class",
      "foreground": "#2B6C00"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#5849CB"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#AA4200"
    },
    {
      "name": "Property",
      "scope": "variable.other.property, variable.other.member",
      "foreground": "#AA4200"
    },
    {
      "name": "Constant",
      "scope": "variable.other.constant, support.constant",
      "foreground": "#0058A3"
    },
    {
      "name": "Language Variable",
      "scope": "variable.language",
      "foreground": "#007284",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#00791B"
    },
    {
      "name": "Template String",
      "scope": "string.interpolated, string.template",
      "foreground": "#00791B"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#0058A3"
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean, constant.language.true, constant.language.false",
      "foreground": "#0058A3"
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "foreground": "#00791B"
    },
    {
      "name": "Escape",
      "scope": "constant.character.escape",
      "foreground": "#AA4200"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation.separator, punctuation.terminator, punctuation.section, punctuation.definition.block, punctuation.definition.parameters, punctuation.definition.group",
      "foreground": "#00878E"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "#896700"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#AA4200"
    },
    {
      "name": "Tag Punctuation",
      "scope": "punctuation.definition.tag",
      "foreground": "#00878E"
    },
    {
      "name": "Decorator",
      "scope": "meta.annotation, punctuation.definition.annotation",
      "foreground": "#A90095"
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.macro, support.function.macro",
      "foreground": "#A90095"
    },
    {
      "name": "Heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#764A00",
      "font_style": "bold"
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Code",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#005AB3"
    },
    {
      "name": "Quote",
      "scope": "markup.quote",
      "foreground": "#005D9F",
      "font_style": "italic"
    },
    {
      "name": "Link",
      "scope": "markup.underline.link",
      "foreground": "#71009C"
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted",
      "foreground": "#00791B"
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted",
      "foreground": "#A4004F"
    },
    {
      "name": "Changed",
      "scope": "markup.changed",
      "foreground": "#896700"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#71009C",
      "font_style": "italic"
    },
    {
      "name": "Invalid",
      "scope": "invalid.illegal",
      "foreground": "#C70025"
    }
  ]
}