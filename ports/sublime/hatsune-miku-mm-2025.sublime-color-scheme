{
  "name": "Hatsune Miku (Magical Mirai 2025)",
  "author": "vauxe",
  "variables": {},
  "globals": {
    "background": "#021C49",
    "foreground": "#DCDDEF",
    "invisibles": "#828F9D",
    "caret": "#FF9EF8",
    "block_caret": "#FF9EF840",
    "line_highlight": "#153163",
    "selection": "#4984E840",
    "selection_foreground": "#DCDDEF",
    "selection_border": "#17DDDD40",
    "selection_border_width": "1",
    "inactive_selection": "#4984E825",
    "inactive_selection_foreground": "#ADCBEB",
    "selection_corner_style": "round",
    "find_highlight": "#99F0FF60",
    "find_highlight_foreground": "#021C49",
    "scroll_highlight": "#17DDDD60",
    "scroll_selected_highlight": "#FF9EF880",
    "highlight": "#17DDDD40",
    "gutter": "#021C49",
    "gutter_foreground": "#869CB4",
    "gutter_foreground_highlight": "#17DDDD",
    "line_diff_added": "#C9F3A4",
    "line_diff_modified": "#E0CD76",
    "line_diff_deleted": "#FFA4B7",
    "minimap_border": "#60759F",
    "brackets_foreground": "#FF9EF8",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#FF9EF8",
    "bracket_contents_options": "underline",
    "tags_foreground": "#FF9EF8",
    "tags_options": "stippled_underline",
    "guide": "#869CB4",
    "active_guide": "#17DDDD",
    "stack_guide": "#ADCBEB",
    "misspelling": "#FFA5B5",
    "fold_marker": "#869CB4",
    "accent": "#17DDDD",
    "shadow": "#00000040",
    "shadow_width": "4",
    "popup_css": "",
    "phantom_css": "",
    "sheet_css": ""
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#94ABC1",
      "font_style": "italic"
    },
    {
      "name": "Documentation Comment",
      "scope": "comment.block.documentation, comment.line.documentation",
      "foreground": "#9DB9D1",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "foreground": "#00F3E4"
    },
    {
      "name": "Control Keyword",
      "scope": "keyword.control",
      "foreground": "#00F3E4"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, punctuation.accessor",
      "foreground": "#DBDDF1"
    },
    {
      "name": "Storage",
      "scope": "storage.type",
      "foreground": "#00F3E4"
    },
    {
      "name": "Storage Modifier",
      "scope": "storage.modifier",
      "foreground": "#00F3E4"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call",
      "foreground": "#99F0FF"
    },
    {
      "name": "Built-in Function",
      "scope": "support.function",
      "foreground": "#00F9D6"
    },
    {
      "name": "Method",
      "scope": "entity.name.function.member, meta.method-call",
      "foreground": "#99F0FF"
    },
    {
      "name": "Class",
      "scope": "entity.name.class, entity.other.inherited-class",
      "foreground": "#FFB9FF"
    },
    {
      "name": "Type",
      "scope": "entity.name.type, support.type",
      "foreground": "#FFDDFF"
    },
    {
      "name": "Interface",
      "scope": "entity.name.interface",
      "foreground": "#9BF7BC"
    },
    {
      "name": "Struct",
      "scope": "entity.name.struct",
      "foreground": "#EEC3FF"
    },
    {
      "name": "Enum",
      "scope": "entity.name.enum",
      "foreground": "#FEBDFF"
    },
    {
      "name": "Enum Member",
      "scope": "variable.other.enummember, constant.other.enum",
      "foreground": "#FFB8FF"
    },
    {
      "name": "Type Parameter",
      "scope": "entity.name.type.parameter",
      "foreground": "#F1DEFF"
    },
    {
      "name": "Namespace",
      "scope": "entity.name.namespace, entity.name.module",
      "foreground": "#FFDDFF"
    },
    {
      "name": "Support Class",
      "scope": "support.class",
      "foreground": "#74FFE9"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#C7CCFF"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#FFD6B5"
    },
    {
      "name": "Property",
      "scope": "variable.other.property, variable.other.member",
      "foreground": "#FFD8B4"
    },
    {
      "name": "Constant",
      "scope": "variable.other.constant, support.constant",
      "foreground": "#FFB8FF"
    },
    {
      "name": "Language Variable",
      "scope": "variable.language",
      "foreground": "#00F3E4",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#E7DB8E"
    },
    {
      "name": "Template String",
      "scope": "string.interpolated, string.template",
      "foreground": "#E7DB8E"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#FFBDFF"
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean, constant.language.true, constant.language.false",
      "foreground": "#FFBDFF"
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "foreground": "#B8EA89"
    },
    {
      "name": "Escape",
      "scope": "constant.character.escape",
      "foreground": "#FFD6B5"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation.separator, punctuation.terminator, punctuation.section, punctuation.definition.block, punctuation.definition.parameters, punctuation.definition.group",
      "foreground": "#8ECDD1"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "#B9F7FF"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#FFD8B4"
    },
    {
      "name": "Tag Punctuation",
      "scope": "punctuation.definition.tag",
      "foreground": "#8ECDD1"
    },
    {
      "name": "Decorator",
      "scope": "meta.annotation, punctuation.definition.annotation",
      "foreground": "#FFDFAE"
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.macro, support.function.macro",
      "foreground": "#FFDFAE"
    },
    {
      "name": "Heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#8FF8B6",
      "font_style": "bold"
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Code",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#48EEFA"
    },
    {
      "name": "Quote",
      "scope": "markup.quote",
      "foreground": "#A6D6FF",
      "font_style": "italic"
    },
    {
      "name": "Link",
      "scope": "markup.underline.link",
      "foreground": "#CDD7FF"
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted",
      "foreground": "#BCE697"
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted",
      "foreground": "#FFA3B0"
    },
    {
      "name": "Changed",
      "scope": "markup.changed",
      "foreground": "#99F0FF"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#FFCDC9",
      "font_style": "italic"
    },
    {
      "name": "Invalid",
      "scope": "invalid.illegal",
      "foreground": "#FFB8BF"
    }
  ]
}