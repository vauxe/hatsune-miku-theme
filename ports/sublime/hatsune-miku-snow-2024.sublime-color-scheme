{
  "name": "Hatsune Miku (Snow Miku 2024)",
  "author": "vauxe",
  "variables": {},
  "globals": {
    "background": "#FEEDDC",
    "foreground": "#532B24",
    "invisibles": "#969391",
    "caret": "#BF4736",
    "block_caret": "#BF473640",
    "line_highlight": "#F1DBCB",
    "selection": "#DB967340",
    "selection_foreground": "#532B24",
    "selection_border": "#658A8540",
    "selection_border_width": "1",
    "inactive_selection": "#DB967325",
    "inactive_selection_foreground": "#4D4845",
    "selection_corner_style": "round",
    "find_highlight": "#82600060",
    "find_highlight_foreground": "#FEEDDC",
    "scroll_highlight": "#658A8560",
    "scroll_selected_highlight": "#BF473680",
    "highlight": "#658A8540",
    "gutter": "#FEEDDC",
    "gutter_foreground": "#908D8B",
    "gutter_foreground_highlight": "#658A85",
    "line_diff_added": "#003300",
    "line_diff_modified": "#5D4800",
    "line_diff_deleted": "#4F0074",
    "minimap_border": "#83655F",
    "brackets_foreground": "#BF4736",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#BF4736",
    "bracket_contents_options": "underline",
    "tags_foreground": "#BF4736",
    "tags_options": "stippled_underline",
    "guide": "#908D8B",
    "active_guide": "#658A85",
    "stack_guide": "#4D4845",
    "misspelling": "#5D0000",
    "fold_marker": "#908D8B",
    "accent": "#658A85",
    "shadow": "#00000040",
    "shadow_width": "4",
    "popup_css": "",
    "phantom_css": "",
    "sheet_css": ""
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#569383",
      "font_style": "italic"
    },
    {
      "name": "Documentation Comment",
      "scope": "comment.block.documentation, comment.line.documentation",
      "foreground": "#488374",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "foreground": "#006F4B"
    },
    {
      "name": "Control Keyword",
      "scope": "keyword.control",
      "foreground": "#006F4B"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, punctuation.accessor",
      "foreground": "#AF0060"
    },
    {
      "name": "Storage",
      "scope": "storage.type",
      "foreground": "#006F4B"
    },
    {
      "name": "Storage Modifier",
      "scope": "storage.modifier",
      "foreground": "#006F4B"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call",
      "foreground": "#826000"
    },
    {
      "name": "Built-in Function",
      "scope": "support.function",
      "foreground": "#734700"
    },
    {
      "name": "Method",
      "scope": "entity.name.function.member, meta.method-call",
      "foreground": "#826000"
    },
    {
      "name": "Class",
      "scope": "entity.name.class, entity.other.inherited-class",
      "foreground": "#326600"
    },
    {
      "name": "Type",
      "scope": "entity.name.type, support.type",
      "foreground": "#8400B1"
    },
    {
      "name": "Interface",
      "scope": "entity.name.interface",
      "foreground": "#006F81"
    },
    {
      "name": "Struct",
      "scope": "entity.name.struct",
      "foreground": "#326600"
    },
    {
      "name": "Enum",
      "scope": "entity.name.enum",
      "foreground": "#326600"
    },
    {
      "name": "Enum Member",
      "scope": "variable.other.enummember, constant.other.enum",
      "foreground": "#00559F"
    },
    {
      "name": "Type Parameter",
      "scope": "entity.name.type.parameter",
      "foreground": "#744C8B"
    },
    {
      "name": "Namespace",
      "scope": "entity.name.namespace, entity.name.module",
      "foreground": "#8400B1"
    },
    {
      "name": "Support Class",
      "scope": "support.class",
      "foreground": "#286900"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#4632B0"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#A23B00"
    },
    {
      "name": "Property",
      "scope": "variable.other.property, variable.other.member",
      "foreground": "#A23B00"
    },
    {
      "name": "Constant",
      "scope": "variable.other.constant, support.constant",
      "foreground": "#00559F"
    },
    {
      "name": "Language Variable",
      "scope": "variable.language",
      "foreground": "#006F4B",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#006C0A"
    },
    {
      "name": "Template String",
      "scope": "string.interpolated, string.template",
      "foreground": "#007617"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#00559F"
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean, constant.language.true, constant.language.false",
      "foreground": "#00559F"
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "foreground": "#007617"
    },
    {
      "name": "Escape",
      "scope": "constant.character.escape",
      "foreground": "#A23B00"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation.separator, punctuation.terminator, punctuation.section, punctuation.definition.block, punctuation.definition.parameters, punctuation.definition.group",
      "foreground": "#008870"
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "foreground": "#826000"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#A23B00"
    },
    {
      "name": "Tag Punctuation",
      "scope": "punctuation.definition.tag",
      "foreground": "#008870"
    },
    {
      "name": "Decorator",
      "scope": "meta.annotation, punctuation.definition.annotation",
      "foreground": "#A0008D"
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.macro, support.function.macro",
      "foreground": "#A0008D"
    },
    {
      "name": "Heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#734700",
      "font_style": "bold"
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Code",
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "#960000"
    },
    {
      "name": "Quote",
      "scope": "markup.quote",
      "foreground": "#8A2100",
      "font_style": "italic"
    },
    {
      "name": "Link",
      "scope": "markup.underline.link",
      "foreground": "#6E0098"
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted",
      "foreground": "#007617"
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted",
      "foreground": "#A0004C"
    },
    {
      "name": "Changed",
      "scope": "markup.changed",
      "foreground": "#826000"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#6E0098",
      "font_style": "italic"
    },
    {
      "name": "Invalid",
      "scope": "invalid.illegal",
      "foreground": "#B90000"
    }
  ]
}