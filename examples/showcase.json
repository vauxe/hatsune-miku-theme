{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Hatsune Miku Theme - JSON Showcase",
  "_description": "No color screams. Every color sings.",

  "theme": {
    "name": "Hatsune Miku Ohime-sama Theme",
    "version": "3.9.39",
    "variants": ["dark", "light"],
    "author": "Miku Fan",
    "license": "MIT"
  },

  "stageArchitecture": {
    "description": "Four background tiers, one canonical voice",
    "canonicalColor": "#39C5BB",

    "backgroundTiers": {
      "void": {
        "step": -1,
        "role": "Empty groups, shadows",
        "isDarkest": true
      },
      "stage": {
        "step": 0,
        "role": "Editor — the performance surface",
        "isDarkest": false
      },
      "house": {
        "step": 1,
        "role": "Structural chrome — sidebar, panels",
        "isDarkest": false
      },
      "float": {
        "step": 2,
        "role": "Menus, hovers, notifications",
        "isDarkest": false
      }
    },

    "hueGrid": {
      "description": "Twelve tones, thirty degrees apart — one hue family per cognitive role",
      "tones": [
        { "degree": 180, "tone": "tonic", "voice": "keywords" },
        { "degree": 120, "tone": "lime", "voice": "strings" },
        { "degree": 240, "tone": "azure", "voice": "constants" },
        { "degree": 270, "tone": "blue", "voice": "types" },
        { "degree": 330, "tone": "magenta", "voice": "operators" },
        { "degree": 20, "tone": "red", "voice": "parameters" }
      ]
    }
  },

  "palette": {
    "teals": {
      "classic": "#39C5BB",
      "sekai": "#33CCBB",
      "neon": "#5DE4DB",
      "ice": "#B2EBE7",
      "deep": "#0D6B65"
    },
    "pinks": {
      "sekai": "#FF6B9D",
      "accessory": "#E05096",
      "soft": "#FF80AB"
    },
    "accents": {
      "amber": "#FFD740",
      "green": "#9CCC65",
      "purple": "#B388FF",
      "coral": "#FF5370"
    }
  },

  "voiceBanks": [
    {
      "id": "v2-classic",
      "name": "Hatsune Miku V2",
      "version": "V2",
      "year": 2007,
      "color": "#39C5BB",
      "frequencyRange": {
        "min": 80,
        "max": 1100
      },
      "tags": ["classic", "original", "iconic"],
      "isActive": true
    },
    {
      "id": "append-sweet",
      "name": "Hatsune Miku Append (Sweet)",
      "version": "Append",
      "year": 2010,
      "color": "#5FCEC8",
      "frequencyRange": {
        "min": 100,
        "max": 900
      },
      "tags": ["append", "sweet", "warm"],
      "isActive": true
    },
    {
      "id": "nt",
      "name": "Hatsune Miku NT",
      "version": "NT",
      "year": 2020,
      "color": "#3ED1C8",
      "frequencyRange": {
        "min": 80,
        "max": 1200
      },
      "tags": ["modern", "technology", "clear"],
      "isActive": true
    }
  ],

  "settings": {
    "semanticHighlighting": true,
    "bracketPairColorization": true,
    "indentGuides": {
      "enabled": true,
      "style": "voicebank-evolution"
    },
    "cursor": {
      "style": "line",
      "blinking": "smooth"
    }
  },

  "numbers": {
    "integer": 39,
    "float": 3.14159,
    "negative": -42,
    "scientific": 1.23e10,
    "hex": "0x39C5BB",
    "binary": "0b101010"
  },

  "booleans": {
    "enabled": true,
    "disabled": false
  },

  "nullValue": null,

  "arrays": {
    "empty": [],
    "strings": ["dark", "soft", "light", "sweet", "vivid", "solid"],
    "numbers": [1, 2, 3, 4, 5, 6],
    "mixed": ["Miku", 39, true, null, { "nested": "object" }]
  },

  "deepNesting": {
    "level1": {
      "level2": {
        "level3": {
          "level4": {
            "level5": {
              "level6": {
                "value": "Deeply nested value",
                "color": "#A8EBE6"
              }
            }
          }
        }
      }
    }
  }
}
